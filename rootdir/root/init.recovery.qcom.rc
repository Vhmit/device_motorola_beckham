import /init.recovery.${ro.boot.device}.rc

on fs
    wait /dev/block/platform/soc/c0c4000.sdhci
    symlink /dev/block/platform/soc/c0c4000.sdhci /dev/block/bootdevice
    symlink /dev/block/bootdevice/by-name/oem_b /dev/block/bootdevice/by-name/system_ext_b
    symlink /dev/block/bootdevice/by-name/oem_a /dev/block/bootdevice/by-name/system_ext_a
    symlink /dev/block/bootdevice/by-name/oem /dev/block/bootdevice/by-name/system_ext

    setprop ro.build.system_root_image true

on init
    setprop sys.usb.configfs 1
