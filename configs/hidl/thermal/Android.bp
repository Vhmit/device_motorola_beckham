cc_binary {
    relative_install_path: "hw",
    defaults: ["hidl_defaults"],
    name: "android.hardware.thermal@1.1-service.beckham",
    proprietary: true,
    init_rc: ["android.hardware.thermal@1.1-service.beckham.rc"],
    srcs: ["service.cpp", "Thermal.cpp", "thermal-helper.cpp"],
    shared_libs: [
        "libbase",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
        "android.hardware.thermal@1.1",
    ],
}
